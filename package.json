{
  "name": "textcount",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TextCount - local-first, accurate text and character counting for mixed Chinese/English text.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
